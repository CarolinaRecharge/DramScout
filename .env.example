# Copy this file to .env and fill in your Supabase project values.
# Get these from: Supabase Dashboard → Project → Settings → API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Push notifications (run: npx web-push generate-vapid-keys)
# VITE_ prefix required so Vite exposes this to the browser at build time
VITE_VAPID_PUBLIC_KEY=BDarlFj1NTByZkF9WxD12CN9IoYcVThHFln_ftQxuj87Fw_i_f2TGr38vLjsK4BfLMu83obQ8oHUIVltTdMSmTI

# Store Mode (server-side only — never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Base URL for constructing QR code claim URLs
# Used server-side in api/lottery/generate-token.js
VITE_BASE_URL=https://dramscout.app

# Phone verification (SMS provider)
# Options: console (default, free — logs code server-side), twilio, messagebird
SMS_PROVIDER=console

# Twilio credentials (only required if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# MessageBird credentials (only required if SMS_PROVIDER=messagebird)
# MESSAGEBIRD_API_KEY=xxxxxxxxxxxxxxxxxxxx
# MESSAGEBIRD_ORIGINATOR=DramScout
